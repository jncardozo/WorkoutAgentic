# Copiar a .env (NO versionado) y completar con valores reales.
# En desarrollo .NET se recomienda dotnet user-secrets en lugar de .env.

# ── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
# Token de acceso de la app de Meta (System User token, permanente)
WHATSAPP_ACCESS_TOKEN=
# Token arbitrario que TÚ defines; Meta lo envía al verificar el webhook
WHATSAPP_VERIFY_TOKEN=
# ID del número de teléfono que envía mensajes
WHATSAPP_PHONE_NUMBER_ID=
# ID de la cuenta de WhatsApp Business
WHATSAPP_BUSINESS_ACCOUNT_ID=
# App Secret de la app de Meta (para validar firma X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
# Versión de la Graph API, ej: v23.0
WHATSAPP_API_VERSION=

# ── Base de datos ────────────────────────────────────────────────────────────
DATABASE_CONNECTION_STRING=

# ── Stitch (Google) — MCP del prototipo UX ───────────────────────────────────
# 1. Generar/rotar la API key en https://aistudio.google.com/apikey
# 2. NO pegar la key aquí: definirla como variable de entorno del usuario, ej:
#    setx STITCH_API_KEY "tu-nueva-key"
#    (abrir OpenCode de nuevo después de setx para que la vea)
STITCH_API_KEY=

# ── Figma (SOLO si se usa el MCP comunitario figma-developer-mcp) ────────────
# Personal Access Token: https://help.figma.com/hc/en-us/articles/8085703771159
# La ruta recomendada es el MCP oficial de Figma (OAuth) y no necesita esta clave.
FIGMA_API_KEY=
