# Reference names for the current student-only runtime. All values are examples.
# The API does NOT automatically load .env files. Set process environment
# variables, use your deployment's environment loader, or use .NET user-secrets.
# See docs/getting-started.md. Never commit a real key or password.

# Required for text interpretation. GEMINI_API_KEY is also accepted as an alias;
# Gemini__ApiKey takes precedence when configured.
Gemini__ApiKey=
# Choose a model available to your key that supports the configured JSON Schema.
# Omit this variable to use the default in GeminiOptions.cs.
# Gemini__ModeloNlu=your-supported-model-id

# Optional: defaults to workoutagentic.db relative to the API content root.
ConnectionStrings__Sqlite=Data Source=workoutagentic.db;Cache=Shared

# Optional: required only for sending confirmed workouts by email.
CorreoSmtp__Host=
CorreoSmtp__Port=587
CorreoSmtp__EnableSsl=true
CorreoSmtp__UserName=
CorreoSmtp__Password=
CorreoSmtp__FromAddress=
CorreoSmtp__FromName=WorkoutAgentic
