{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"

  // Placeholder inerte: EF Core + SQLite entran con el PRIMER SLICE (ADR-0002 S3),
  // aquí todavía no se instala ningún provider.
  // UseWAL=true documentado: al implementar, Microsoft.Data.Sqlite no parsea la
  // clave nativamente, así que el slice que abra la conexión debe ejecutar la
  // PRAGMA `journal_mode=WAL` (conociendo esta cadena o leyendo esta config).
  ,
  "ConnectionStrings": {
    "Sqlite": "Data Source=workoutagentic.db;Cache=Shared;UseWAL=true"
  }
}
