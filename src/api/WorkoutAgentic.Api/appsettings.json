{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // SQLite (ADR-0002 S3). UseWAL no es una clave parseada por Microsoft.Data.Sqlite:
  // el modo WAL se establece con la PRAGMA `journal_mode=WAL` en el arranque
  // (Data/DbInitializer.cs) y queda persistente en el archivo de la base.
  "ConnectionStrings": {
    "Sqlite": "Data Source=workoutagentic.db;Cache=Shared"
  }
}
